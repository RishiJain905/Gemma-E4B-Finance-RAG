# .gitignore

# Data files (generated, not committed)
data/
*.db
*.sqlite

# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs
logs/
*.log

# Coverage / test artifacts
.coverage
coverage_report/
htmlcov/
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

#environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production
