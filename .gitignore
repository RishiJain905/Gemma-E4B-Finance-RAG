# .gitignore

# Data files (generated, not committed)
data/
data/symbol_catalog.json
data/tracked_dynamic.json
*.db
*.sqlite

# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs
logs/
*.log

# Coverage / test artifacts
.coverage
coverage_report/
htmlcov/
.pytest_cache/
.ruff_cache/

# Eval harness — per-run artifacts (the golden set IS committed)
eval/runs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

#environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production

# Machine-specific model paths (copy from configs/model.example.yaml)
configs/model.local.yaml
