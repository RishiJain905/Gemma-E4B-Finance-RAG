# Environment variables for Gemma-E4B-Finance-RAG / FinanceBot
#
# Copy this file to `.env` in the project root and fill in real values.
# Never commit `.env` — it is gitignored.
#
# After saving `.env`, populate/refresh the RAG with:
#   python -m src.scheduler bootstrap
#   python -m src.scheduler status
#
# Then start the middleware (embeddings optional for lexical/SQLite facts;
# required for Chroma vector search and ingestion that embeds documents):
#   uvicorn src.middleware.app:app --host 127.0.0.1 --port 8000

# ── Required for core ingestion ──────────────────────────
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent: name + contact email
SEC_EDGAR_USER_AGENT=Your Name you@example.com

# ── Optional providers (missing key disables only that source) ──
FINNHUB_API_KEY=
MASSIVE_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
OPENFDA_API_KEY=

# Free/freemium vendor adapters (missing key → disabled_missing_key for that source)
# Alpha Vantage free tier ~25 req/day — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Financial Modeling Prep free Basic ~250 calls/day — https://site.financialmodelingprep.com/developer
FMP_API_KEY=
# Marketaux free ~100 req/day — https://www.marketaux.com/ (also accepts MARKETAUX_API_TOKEN)
MARKETAUX_API_KEY=
# OpenFIGI optional — works without a key; key raises rate limits — https://www.openfigi.com/api
OPENFIGI_API_KEY=

# Optional / unused unless you enable a Twelve Data adapter
TWELVE_DATA_API_KEY=

# ── Model-agnostic inference (optional; not required for FinanceBot RAG tools) ──
# OpenAI-compatible chat + embeddings. Defaults are local llama-server.
# FinanceBot retrieval/tools work without a Gemma (or any) chat model.
# CHAT_ENDPOINT is an alias for LLAMA_ENDPOINT.
# LLAMA_ENDPOINT=http://127.0.0.1:8087/v1/chat/completions
# EMBEDDING_ENDPOINT=http://127.0.0.1:8087/v1/embeddings
# MODEL_NAME=tracealchemy
# EMBEDDING_MODEL=tracealchemy

# Optional local GGUF paths if you still run scripts/serve_model.*
# MAIN_MODEL_PATH=
# LLAMA_BUILD_DIR=
# DRAFT_MODEL_PATH=

# ── FinanceBot hit/miss thresholds (optional) ────────────
# FINANCEBOT_MIN_FACTS=1
# FINANCEBOT_MIN_DOCUMENTS=1
# FINANCEBOT_MIN_DOCUMENT_SCORE=0.0

# Middleware profile: legacy | recommended | evaluation
# MIDDLEWARE_PROFILE=recommended
